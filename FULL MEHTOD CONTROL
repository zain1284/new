using System;
using System.Linq;
using System.Threading.Tasks;

public class RemotePatch
{
    public static async void Run(dynamic status, dynamic memory)
    {
        status.Text = "Activating...";

        try
        {
            // AoB pattern with wildcards (??) using @"..." so Roslyn allows it
            string aob = @"C8 00 00 00 00 00 ?? ?? 00 00 00 00 05 00 00 00 01 00 00 00 B4 C8 D6 3F ?? ?? ?? ?? B4 C8 D6 3F";
            string patch = @"C8 00 00 00 00 00 00 00 00 00 00 00 05 00 00 00 01 00 00 00 B4 C8 D6 3F 01 00 00 00 B4 C8 D6 3F";

            string[] proc = { "HD-Player" };

            if (!memory.SetProcess(proc))
            {
                status.Text = "❌ Process not found.";
                return;
            }

            var addrs = await memory.AoBScan(aob);
            if (addrs == null || !addrs.Any())
            {
                status.Text = "❌ Pattern not found.";
                return;
            }

            foreach (var addr in addrs)
                memory.AobReplace(addr, patch);

            status.Text = "✅ Patch Applied";
            Console.Beep(2000, 400);
        }
        catch (Exception ex)
        {
            status.Text = "❌ Failed: " + ex.Message;
        }
    }
}
